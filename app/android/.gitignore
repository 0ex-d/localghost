# Gradle
.gradle/
build/
*/build/

# Native build: CMake's configure and build trees for the phone model's runtime (llama.cpp is
# fetched and compiled in here, per ABI and per build type: hundreds of MB). Regenerated by every
# build; delete it to make CMake start fresh.
.cxx/
.externalNativeBuild/
 
# Kotlin 2.x compiler session data
.kotlin/

# Android / IDE local config
local.properties
.idea/
*.iml


# Keystores and signing — never commit these
*.jks
*.keystore
keystore.properties

# OS noise
.DS_Store.cache/
.cache/
