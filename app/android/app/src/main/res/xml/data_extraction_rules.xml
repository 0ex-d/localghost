<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a phone-to-phone transfer. allowBackup="false" stops
     the cloud backup, but on Android 12 and later it no longer stops a device-to-device transfer
     (a new phone set up from the old one by cable or Wi-Fi), which copied the app's files: the
     location trail, the pending voice notes and photos, the map tiles, the settings. A new phone
     enrols with the box's QR like any other (free-time notes, 30 Sep 2026). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
